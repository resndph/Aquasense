{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Auth",
    "type": "object",
    "properties": {
        "nome": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
        },
        "email": {
        "type": "string",
        "format": "email",
        "maxLength": 120
        },
        "password": {
        "type": "string",
        "minLength": 6,
        "maxLength": 50
        }
    },
    "required": ["email", "password"],
    "additionalProperties": false
}